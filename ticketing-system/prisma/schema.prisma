generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  tokens   Int    @default(0) // Internal currency for TicketRush

  // Account Status & Soft Delete
  status        UserStatus @default(ACTIVE)
  deletedAt     DateTime?
  reactivatedAt DateTime?

  // Security & Lifecycle
  emailVerified DateTime?
  role          Role      @default(USER)
  lastLogin     DateTime?
  loginAttempts Int       @default(0)
  lockoutUntil  DateTime?

  // Audit Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tickets       Ticket[]
  authAuditLogs AuthAuditLog[]
  sessions      Session[]
}

// New: The Session Table for Refresh Token Rotation
model Session {
  id               String @id @default(cuid())
  refreshTokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  SUSPENDED
  BANNED
}

enum Role {
  USER
  MODERATOR
  SUPERADMIN
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Event {
  id           String   @id @default(cuid())
  title        String
  description  String?
  location     String
  price        Int
  totalTickets Int
  ticketsSold  Int      @default(0)
  startDate    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tickets      Ticket[]
}

model Ticket {
  id     String @id @default(cuid())
  status String @default("PENDING")

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())
}
